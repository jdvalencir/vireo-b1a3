# ---------------------------------------------------------------
# Wompi — Dashboard > Desarrolladores > Secretos para integración
# ---------------------------------------------------------------
# Usa las llaves de PRUEBA (pub_test_..., prv_test_...) hasta que
# todo funcione. Solo entonces cambia a las de producción.

# Llave pública. Viaja al navegador: puede ser pública sin problema.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Llave privada. NUNCA la pongas en una variable NEXT_PUBLIC_.
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de integridad: firma el monto para que nadie lo altere.
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de eventos: valida que los webhooks vengan de Wompi.
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pruebas: https://sandbox.wompi.co/v1
# Producción: https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1

# URL pública del sitio. Wompi devuelve al usuario aquí tras pagar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
